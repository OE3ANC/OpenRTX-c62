#
# Retevis C62 board-specific configuration.
#
# Only options strictly related to the C62 hardware belong here.
# SoC-level options for the ListenAI CSK6011B chip live in
# platform/mcu/CSK6011B/zephyr.conf.
#

CONFIG_BOARD_C62=y

# C62 LCD (Sitronix ST7735R over SPI)
CONFIG_DISPLAY=y
CONFIG_ST7735R=y

# C62 LSF service controller, see Kconfig.board
CONFIG_LSF_SERVICE_CONTROLLER=y

# Reserve flash above 1 MiB for the DSP image.
CONFIG_FLASH_LOAD_SIZE=0x100000
